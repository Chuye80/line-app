# Copy to .env and fill in. Never commit the real file.

# Direct PostgreSQL connection to the Supabase project. The API is the only
# writer, and it connects with a role that bypasses row level security, so the
# tables can stay closed to the public publishable key.
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# Supabase project, used to verify access tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. When set, HS256 access tokens are verified locally instead of
# costing a round-trip to the Auth service. Tokens signed with any other
# algorithm still fall back to Supabase. Find it under
# Project Settings > API > JWT Settings.
# SUPABASE_JWT_SECRET=

# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mounts /dev/*, which delete virtual members, wipe registrations and rewrite
# the schedule. Leave off everywhere except local development.
ENABLE_DEV_ENDPOINTS=false

# How long a verified access token may be reused before it is checked again.
# Never extends past the token's own expiry.
AUTH_CACHE_SECONDS=60

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
