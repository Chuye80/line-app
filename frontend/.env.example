# Copy to frontend/.env and fill in.

# Supabase project, used for authentication only. The publishable key is
# embedded in the built JavaScript and is public by design, which is why the
# database tables are closed to it (see supabase/migrations).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Base URL of the LineApp API. Defaults to the local backend when unset.
VITE_API_URL=http://127.0.0.1:8000

# Shows the destructive developer panel. Leave unset outside local development;
# the backend must also have ENABLE_DEV_ENDPOINTS turned on.
VITE_ENABLE_DEV_TOOLS=false
